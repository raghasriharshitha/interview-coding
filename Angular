Service Class;

@Injectable({
    ProvidedIn: root
})
export class EmployeeService {
    getEmployee() {
        return this.http.get<any[]>('/api/employees');
    }

    saveEmployee(employees: any) {
        return this.http.post('/api/employees', employees);
    }
}
