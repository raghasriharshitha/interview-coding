    fetchEmployeeDetails() {
        this.employeeService.getEmployee().
        subscribe(data = {
            this.employees = data;
        });
    }

    saveEmployee() {
        const employee = {
            id: this.employeeForm.get('id')?.value,
            name: this.employeeForm.get('name')?.value,
